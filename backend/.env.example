# Session pooler (IPv4). Host db.*.supabase.co é IPv6-only e falha no Windows.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require

SUPABASE_URL=

# service_role: só admin (criar/apagar users). Nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Mesma chave anon do frontend (NEXT_PUBLIC_SUPABASE_ANON_KEY). Usada em POST /login.
SUPABASE_ANON_KEY=

# Só precisa se ainda existirem JWTs HS256 antigos. Tokens novos são ES256 via JWKS.
SUPABASE_JWT_SECRET=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Rate limit do POST /login está no código: 5/minute por IP.

# Só para python reset_pass.py — não subir o servidor web com isto no processo se não precisares.
ADMIN_RESET_EMAIL=
ADMIN_RESET_PASSWORD=

# Movingpay v3: conta de serviço da integração, só no backend. Customer = id da empresa no console (Deltapag = 149).
MOVINGPAY_EMAIL=
MOVINGPAY_PASSWORD=
MOVINGPAY_CUSTOMER_ID=
